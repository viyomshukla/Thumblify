# ---- Core ----
PORT=5000
NODE_ENV=production
# Full origin of the deployed frontend (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app
# Any long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Database ----
MONGODB=mongodb+srv://user:pass@cluster.mongodb.net/thumblify

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the Authorized redirect URI in Google Cloud Console
GOOGLE_CALLBACK_URL=https://your-backend.onrender.com/api/auth/google/callback

# ---- AI ----
REPLICATE_API_TOKEN=
GEMINI_API_KEY=

# ---- Image storage ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Payments ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- WhatsApp (optional) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
WHATSAPP_VERIFY_TOKEN=

# ---- Email (optional) ----
EMAIL_USER=
EMAIL_PASS=
